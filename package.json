{
  "name": "bingo-io",
  "version": "1.0.0",
  "description": "Multiplayer real-time Bingo game inspired by skribbl.io",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "scripts": {
    "dev:server": "npm --workspace=server run dev",
    "dev:client": "npm --workspace=client run dev",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run dev:server\" \"npm run dev:client\"",
    "build:client": "npm --workspace=client run build",
    "build": "npm run build:client",
    "start": "npm --workspace=server start",
    "test": "npm --workspace=server run test"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
